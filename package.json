{
  "name": "@ai-clyde/writelikeme",
  "version": "1.0.2",
  "description": "WriteLikeMe - Writing Style Visualizer. Generates a QR-inspired style code with circular signals whose count and size encode writing-style scores.",
  "main": "index.js",
  "scripts": {
    "test": "node --experimental-vm-modules test.js",
    "generate": "node index.js",
    "analyze": "node index.js analyze",
    "docs:build": "node scripts/copy-browser.js && vitepress build docs"
  },
  "bin": {
    "writelike-me": "index.js"
  },
  "keywords": [
    "writing",
    "style",
    "visualizer",
    "svg",
    "AI",
    "NPM",
    "content analysis"
  ],
  "author": "Clyde AI Project",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PyMite6941/WriteLikeMe.git"
  },
  "homepage": "https://pymite6941.is-a.dev/WriteLikeMe/",
  "devDependencies": {
    "vitepress": "^1.6.4"
  },
  "overrides": {
    "vite": "6.4.4"
  }
}
