{
  "name": "@ai-clyde/writelikeme",
  "version": "1.2.0",
  "description": "Capture your writing style as a portable SVG style code and have any AI agent write like you. Offline analyzer, CLI and MCP server for Claude Code, Cursor, Codex and more.",
  "main": "index.js",
  "files": [
    "cli.js",
    "index.js",
    "handler.js",
    "mcp.js",
    "README.md"
  ],
  "scripts": {
    "test": "node test.js && node handler.test.js && node mcp.test.js && node package.test.js && node verify.mjs && node bench/bench.js",
    "bench": "node bench/bench.js",
    "generate": "node cli.js generate",
    "analyze": "node cli.js analyze",
    "write": "node cli.js write",
    "docs:build": "node scripts/copy-browser.js && vitepress build docs",
    "docs:dev": "node scripts/copy-browser.js && vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "brief": "node cli.js brief",
    "mcp": "node cli.js mcp"
  },
  "bin": {
    "writelike-me": "cli.js"
  },
  "keywords": [
    "writing",
    "style",
    "visualizer",
    "svg",
    "AI",
    "NPM",
    "content analysis",
    "offline writing",
    "style profile",
    "text generation",
    "mcp",
    "mcp-server",
    "claude-code",
    "cursor",
    "codex",
    "agent",
    "style-guide",
    "writing-style",
    "llm",
    "ai-agents"
  ],
  "author": "Clyde AI Project",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PyMite6941/WriteLikeMe.git"
  },
  "homepage": "https://pymite6941.github.io/WriteLikeMe/",
  "devDependencies": {
    "vitepress": "^1.6.4"
  },
  "overrides": {
    "vite": "6.4.4"
  },
  "bugs": {
    "url": "https://github.com/PyMite6941/WriteLikeMe/issues"
  }
}
