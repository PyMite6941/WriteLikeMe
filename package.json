  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PyMite6941/WriteLikeMe.git"
  },
  "homepage": "https://pymite6941.github.io/WriteLikeMe/",
  "devDependencies": {
    "vitepress": "^1.6.4"
  },
  "overrides": {
    "vite": "6.4.4"
  }
}
