{
  "name": "@ai-clyde/writelikeme",
  "version": "1.0.3",
  "description": "Analyze writing locally, share style profiles in SVG metadata, and create deterministic style-guided drafts without an external AI service.",
  "main": "index.js",
  "files": [
    "cli.js",
    "index.js",
    "README.md"
  ],
  "scripts": {
    "test": "node test.js",
    "generate": "node cli.js generate",
    "analyze": "node cli.js analyze",
    "write": "node cli.js write",
    "docs:build": "node scripts/copy-browser.js && vitepress build docs"
  },
  "bin": {
    "writelike-me": "cli.js"
  },
  "keywords": [
    "writing",
    "style",
    "visualizer",
    "svg",
    "AI",
    "NPM",
